# Copy to .env and fill in. Point endpoints at your own servers.
# VLM inference endpoint (OpenAI-compatible, e.g. vLLM)
VLM_BASE_URL=http://localhost:10021/v1
# MCP tool servers (detection/ocr/etc.)
MCP_TOOL_URL=http://localhost:10009/mcp
# DashScope key (only if using the Qwen-Embedding probe encoder)
DASHSCOPE_API_KEY=
# Optional tracing (Langfuse)
LANGFUSE_HOST=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# MinIO / S3 object store (for tool image uploads)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=deep-research
MINIO_SECURE=false
